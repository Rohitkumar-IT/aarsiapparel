# ───────── Aarsi Apparel storefront ─────────
# Copy to .env.local (dev) or set these in your hosting dashboard (prod).

# Public URL of THIS storefront (used for SEO, sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=https://www.aarsiapparel.com

# Backend (admin) API. Server-side fetches and the /api proxy use this.
# Never put a trailing slash.
API_BASE_URL=https://admin.aarsiapparel.com

# ISR cache window (seconds) for catalog/blog pages. Lower = fresher, higher = faster.
CATALOG_REVALIDATE_SECONDS=60

# Contact details shown in header/footer/contact page (from the visiting card)
NEXT_PUBLIC_STORE_PHONE=+91 8745889898
NEXT_PUBLIC_STORE_EMAIL=info@aarsiapparel.com
NEXT_PUBLIC_STORE_ADDRESS=G-47 C, Galaxy Blue Sapphire Plaza, Plot - C 03, Sector-4, Greater Noida West

# Country code + number, digits only. Orders are sent here on WhatsApp
# until a public order-creation API exists.
NEXT_PUBLIC_WHATSAPP_NUMBER=918745889898

# Optional: analytics id (leave blank to disable)
NEXT_PUBLIC_GA_ID=

# ───────── Order flow ─────────
# "off" = customers send their order to your WhatsApp (works today, no backend needed)
# "on"  = use the order APIs in docs/API_SPEC.md (quote, pincode, orders, Razorpay, tracking)
NEXT_PUBLIC_COMMERCE_API=off

# Return window shown on product pages / FAQ. Set to 0 to hide. Edit to match your real policy.
NEXT_PUBLIC_RETURN_DAYS=7

# Optional extras for the ticker (separate with |) and footer social link
NEXT_PUBLIC_ANNOUNCEMENTS=
NEXT_PUBLIC_INSTAGRAM_URL=
